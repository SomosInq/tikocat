

<script
  src="{{ 'blog-posts-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<blog-posts-list section-id="{{ section.id }}">
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div
    class="
      section
      color-{{ section.settings.color_scheme }}
      blog-posts
      spacing-style
      size-style
    "
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% content_for 'blocks' %}

    {%- if section.settings.enable_tag_filter and blog.all_tags.size > 0 -%}
      <ul class="blog-category-filter" role="list">
        <li class="blog-category-filter__item{% unless current_tags %} blog-category-filter__item--active{% endunless %}">
          <a href="{{ blog.url }}">{{ 'actions.view_all' | t }}</a>
        </li>
        {%- for tag in blog.all_tags -%}
          <li class="blog-category-filter__item{% if current_tags contains tag %} blog-category-filter__item--active{% endif %}">
            {{ tag | link_to_tag: tag }}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- paginate blog.articles by 12 -%}
      <span ref="viewMorePrevious"></span>
      <div
        ref="grid"
        class="blog-posts-container"
        data-last-page="{{ paginate.pages }}"
      >
        {% for article in blog.articles %}
          <div
            class="blog-post-item"
            ref="cards[]"
            data-page="{{ paginate.current_page }}"
          >
            {% content_for 'block', id: 'static-blog-post-card', type: '_blog-post-card', article: article %}
          </div>
        {% endfor %}
      </div>
      <span ref="viewMoreNext"></span>
    {%- endpaginate -%}
  </div>
</blog-posts-list>

{% stylesheet %}
  /**
   * Blog posts page layout
   */
  .blog-posts {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
    --columns-gap: 36px;
    --rows-gap: 36px;
  }

  .blog-posts-container {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1rem;
    width: 100%;
    column-gap: var(--columns-gap);
    row-gap: var(--rows-gap);
  }

  /**
   * Apart from the first and second rows in the grid, all remaining blog posts
   * are arranged in a three-column layout:
   * +------------+------------+-------------+
   * |            |            |             |
   * |  (span 2)  |  (span 2)  |  (span 2)   |
   * |            |            |             |
   * +------------+------------+-------------+
   */
  .blog-post-item {
    --blog-post-card-scale: 0.6;

    grid-column: span 2;

    @media screen and (max-width: 749px) {
      --blog-post-card-scale: 0.5;

      grid-column: span 6;
    }
  }

  /**
   * The second row of blog posts has two columns:
   * +-------------------+-------------------+
   * |                   |                   |
   * |  (column span 3)  |  (column span 3)  |
   * |                   |                   |
   * +-------------------+-------------------+
   */
  .blog-post-item:nth-child(2),
  .blog-post-item:nth-child(3) {
    --blog-post-card-scale: 0.8;

    grid-column: span 3;

    @media screen and (max-width: 749px) {
      --blog-post-card-scale: 0.5;

      grid-column: span 6;
    }
  }

  /**
   * The first row of blog posts has only one column:
   * +---------------------------------------+
   * |                                       |
   * |           (1 column span 6)           |
   * |                                       |
   * +---------------------------------------+
   */
  .blog-post-item:first-child {
    --blog-post-card-scale: 1;

    grid-column: span 6;
  }

  /**
   * When there's no image, the blog post item has a border.
   */
  .blog-post-item {
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    padding: 0 1rem 1rem;
  }

  .blog-post-item:has(.blog-post-card__image-container) {
    border: none;
    padding: 0;
  }

  /**
   * Category filter pills, generated from article tags. Visually matches the
   * theme's button/button-secondary components without reusing those classes
   * directly, since the tag links are rendered via the `link_to_tag` filter
   * and can't take a class attribute of their own.
   */
  .blog-category-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-xs);
    list-style: none;
    margin: 0 0 var(--rows-gap);
    padding: 0;
  }

  .blog-category-filter__item a {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    text-decoration: none;
    font-family: var(--button-font-family-secondary);
    text-transform: var(--button-text-case-secondary);
    border-radius: var(--style-border-radius-buttons-secondary);
    padding-block: var(--button-padding-block);
    padding-inline: var(--button-padding-inline);
    color: var(--color-secondary-button-text);
    background-color: var(--color-secondary-button-background);
    box-shadow: inset 0 0 0 var(--style-border-width-secondary) var(--color-secondary-button-border);
    transition: color var(--animation-speed) var(--animation-easing),
      box-shadow var(--animation-speed) var(--animation-easing),
      background-color var(--animation-speed) var(--animation-easing);
  }

  .blog-category-filter__item a:hover {
    color: var(--color-secondary-button-hover-text);
    background-color: var(--color-secondary-button-hover-background);
    box-shadow: inset 0 0 0 var(--style-border-width-secondary) var(--color-secondary-button-hover-border);
  }

  .blog-category-filter__item--active a {
    color: var(--color-primary-button-text);
    background-color: var(--color-primary-button-background);
    box-shadow: inset 0 0 0 var(--style-border-width-primary) var(--color-primary-button-border);
  }

  .blog-category-filter__item--active a:hover {
    color: var(--color-primary-button-hover-text);
    background-color: var(--color-primary-button-hover-background);
    box-shadow: inset 0 0 0 var(--style-border-width-primary) var(--color-primary-button-hover-border);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_posts",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Filters"
    },
    {
      "type": "checkbox",
      "id": "enable_tag_filter",
      "label": "t:settings.enable_filtering",
      "info": "Categories are generated automatically from your blog articles' tags.",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
