{%- comment -%}
  Product Compare section.

  Lets a shopper choose a category (one of the "Category" blocks configured
  by the merchant, each holding its own curated product list), then choose
  two products within that category to see a side-by-side spec comparison
  table built from each product's `compare.specs` metafield (a list of
  metaobjects with `label`/`value` fields).

  Categories are defined as blocks directly in this section's own schema
  (rather than a separate blocks/ file) with a native `product_list`
  setting, so `section.blocks` and each block's settings resolve reliably
  when read from this parent template.

  The first category and its first two products are pre-selected below so
  the page never shows an empty state on first load; assets/product-compare.js
  renders the actual comparison table for that default selection as soon as
  it connects, by calling the same onProductChange() logic a real user
  interaction would trigger.
{%- endcomment -%}

{% liquid
  assign default_category_block = section.blocks | first
  assign default_products = blank
  assign default_product_a = blank
  assign default_product_b = blank

  if default_category_block.settings.product_list.size > 0
    assign default_products = default_category_block.settings.product_list

    for product in default_products
      if forloop.index == 1
        assign default_product_a = product
      endif
      if forloop.index == 2
        assign default_product_b = product
      endif
    endfor
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    spacing-style"
    
    style="
        {% render 'layout-panel-style', settings: section.settings %}
        {% render 'spacing-style', settings: section.settings %}
      ">
<product-compare-component
  class="
    product-compare
  "
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {% if section.settings.heading != blank %}
    <h2 class="product-compare__heading">{{ section.settings.heading | escape }}</h2>
  {% endif %}

  <div class="product-compare__pickers">
    <div class="product-compare__field">
      <label
        for="ProductCompareCategory-{{ section.id }}"
        class="visually-hidden"
      >
        {{ section.settings.category_placeholder | escape }}
      </label>
      <div class="product-compare__select-wrapper">
        <select
          id="ProductCompareCategory-{{ section.id }}"
          ref="categorySelect"
          class="product-compare__select"
          on:change="/onCategoryChange"
        >
          <option value="">{{ section.settings.category_placeholder | escape }}</option>
          {% for block in section.blocks %}
            {% if block.settings.title != blank %}
              <option
                value="{{ block.id }}"
                {% if block == default_category_block %}selected{% endif %}
              >
                {{- block.settings.title | escape -}}
              </option>
            {% endif %}
          {% endfor %}
        </select>
        <svg
          aria-hidden="true"
          focusable="false"
          class="icon icon-caret"
          viewBox="0 0 10 6"
        >
          {%- render 'icon', icon: 'caret' -%}
        </svg>
      </div>
    </div>

    <div class="product-compare__field">
      <label
        for="ProductCompareProductA-{{ section.id }}"
        class="visually-hidden"
      >
        {{ section.settings.product_placeholder | escape }}
      </label>
      <div class="product-compare__select-wrapper">
        <select
          id="ProductCompareProductA-{{ section.id }}"
          ref="productSelectA"
          class="product-compare__select"
          on:change="/onProductChange"
          {% if default_products == blank %}disabled{% endif %}
        >
          <option value="">{{ section.settings.product_placeholder | escape }}</option>
          {% for product in default_products %}
            {% unless product == default_product_b %}
              <option
                value="{{ product.id }}"
                {% if product == default_product_a %}selected{% endif %}
              >
                {{- product.title | escape -}}
              </option>
            {% endunless %}
          {% endfor %}
        </select>
        <svg
          aria-hidden="true"
          focusable="false"
          class="icon icon-caret"
          viewBox="0 0 10 6"
        >
          {%- render 'icon', icon: 'caret' -%}
        </svg>
      </div>
    </div>

    <div class="product-compare__field">
      <label
        for="ProductCompareProductB-{{ section.id }}"
        class="visually-hidden"
      >
        {{ section.settings.product_placeholder | escape }}
      </label>
      <div class="product-compare__select-wrapper">
        <select
          id="ProductCompareProductB-{{ section.id }}"
          ref="productSelectB"
          class="product-compare__select"
          on:change="/onProductChange"
          {% if default_products == blank %}disabled{% endif %}
        >
          <option value="">{{ section.settings.product_placeholder | escape }}</option>
          {% for product in default_products %}
            {% unless product == default_product_a %}
              <option
                value="{{ product.id }}"
                {% if product == default_product_b %}selected{% endif %}
              >
                {{- product.title | escape -}}
              </option>
            {% endunless %}
          {% endfor %}
        </select>
        <svg
          aria-hidden="true"
          focusable="false"
          class="icon icon-caret"
          viewBox="0 0 10 6"
        >
          {%- render 'icon', icon: 'caret' -%}
        </svg>
      </div>
    </div>
  </div>

  <div
    ref="table"
    class="product-compare__table-wrapper"
  >
    <p class="product-compare__empty-state">{{ section.settings.empty_state_text | escape }}</p>
  </div>

  <script
    ref="categoriesData"
    type="application/json"
  >
    [
      {% for block in section.blocks %}
        {
          "id": {{ block.id | json }},
          "title": {{ block.settings.title | json }},
          "products": [
            {% for product in block.settings.product_list %}
              {
                "id": {{ product.id | json }},
                "title": {{ product.title | json }},
                "url": {{ product.url | json }},
                "image": {{ product.featured_image | image_url: width: 200 | json }},
                "price": {{ product.price | money | json }},
                "specs": [
                  {% for spec in product.metafields.compare.specs.value %}
                    {
                      "label": {{ spec.label.value | json }},
                      "value": {{ spec.value.value | json }}
                    }{% unless forloop.last %},{% endunless %}
                  {% endfor %}
                ]
              }{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>

  <script
    src="{{ 'product-compare.js' | asset_url }}"
    type="module"
  ></script>
</product-compare-component>
</div>
{% stylesheet %}
  .product-compare {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl);
  }

  .product-compare__heading {
    margin: 0;
  }

  .product-compare__pickers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gap-md);

    @media screen and (max-width: 749px) {
      grid-template-columns: 1fr;
    }
  }

  .product-compare__select-wrapper {
    display: flex;
    position: relative;
    border: var(--style-border-width-inputs) solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    align-items: center;
    overflow: clip;
  }

  .product-compare__select {
    appearance: none;
    border: 0;
    margin: 0;
    width: 100%;
    background: transparent;
    color: inherit;
    cursor: pointer;
    padding-block: var(--padding-md);
    padding-inline: var(--padding-lg) calc(var(--padding-lg) + var(--icon-size-xs));

    &:disabled {
      cursor: not-allowed;
      opacity: var(--opacity-40);
    }
  }

  .product-compare__select-wrapper .icon {
    position: absolute;
    right: var(--padding-md);
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .product-compare__empty-state {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }

  /* Comparison table — visual language borrowed from the (currently unused)
     blocks/compare-products.liquid demo block, so a merchant swapping between
     the two ends up with a consistent look. */
  .compare-products-table {
    width: 100%;
  }

  .compare-products-row {
    display: flex;
    gap: 18px;
    padding-bottom: 16px;
    margin-bottom: 18px;
  }

  .compare-product-box {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 24px;
    color: inherit;
    text-decoration: none;

    &:hover .compare-product-name {
      text-decoration: underline;
    }
  }

  .compare-product-image img {
    border-radius: 8px;
    display: block;
  }

  .compare-product-image {
    max-width: 96px;
  }

  .compare-product-name {
    font-size: 16px;
    font-weight: 500;
  }

  .compare-product-price {
    font-size: 12px;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }

  .comparison-criteria-label {
    padding: 20px 0 16px 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 16.5px;
    margin-bottom: 16px;
  }

  .comparison-row-feature {
    display: flex;
    gap: 18px;
  }

  .compare-product-feature {
    width: 100%;
    display: flex;
    gap: 8px;
    padding: 0 24px;
  }

  .compare-product-feature-value {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }

  .comparison-row {
    padding-bottom: 18.2px;
  }

  .product-compare__table-wrapper {
    border-radius: 9px;
    border: 1px solid var(--Lime-Green, #D3FF33);
    padding: 80px;
  }

  @media screen and (max-width: 749px) {
    .compare-product-box {
      flex-direction: column;
      text-align: center;
    }

    .compare-product-image {
      max-width: 100%;
    }

    .compare-product-feature {
      padding: 0;
    }
    .product-compare__table-wrapper {
      padding: 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product compare",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Compare products"
    },
    {
      "type": "header",
      "content": "t:content.text"
    },
    {
      "type": "text",
      "id": "category_placeholder",
      "label": "Category select placeholder",
      "default": "Select a category"
    },
    {
      "type": "text",
      "id": "product_placeholder",
      "label": "Product select placeholder",
      "default": "Select a product"
    },
    {
      "type": "text",
      "id": "empty_state_text",
      "label": "Empty state text",
      "default": "Choose two products to compare."
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category name",
          "default": "Category"
        },
        {
          "type": "product_list",
          "id": "product_list",
          "label": "Products",
          "limit": 24
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product compare",
      "category": "t:categories.products"
    }
  ]
}
{% endschema %}
